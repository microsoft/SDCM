<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hardware Dev Center API client -->
    <PackageVersion Include="Microsoft.Devices.HardwareDevCenterManager" Version="3.0.20" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />

    <!-- Hosting / DI / configuration -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />

    <!-- Authentication -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
